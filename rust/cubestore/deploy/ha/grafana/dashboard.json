{
  "__inputs": [
    {
      "name": "DS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Cube Store HA (rocksdb-raft)",
  "uid": "cubestore-ha",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "type": "stat",
      "title": "Leader per node (1=leader)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "cubestore_raft_is_leader",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Follower",
                  "color": "blue"
                },
                "1": {
                  "text": "LEADER",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "type": "timeseries",
      "title": "Raft term (jumps = elections)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "max(cubestore_raft_term)",
          "legendFormat": "term",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "step": 15
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "type": "timeseries",
      "title": "Applied log index per node (must converge)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "cubestore_raft_last_applied",
          "legendFormat": "node {{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "type": "timeseries",
      "title": "Local apply lag (alert >100)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "cubestore_raft_apply_lag",
          "legendFormat": "node {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "type": "stat",
      "title": "RaftCore running (alert =0)",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "cubestore_raft_running_state_ok",
          "legendFormat": "node {{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "type": "state-timeline",
      "title": "Leader identity",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "cubestore_raft_leader",
          "legendFormat": "node {{node}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}