  },
  "optionalDependencies": {
    "@cubejs-backend/jdbc": "^0.8.1"
  },
  "devDependencies": {
    "@cubejs-backend/linter": "1.6.61",
    "@types/node": "^20",
    "typescript": "~5.2.2"
  },
  "eslintConfig": {
    "extends": "../cubejs-linter"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
