{
  "name": "@cubejs-backend/gaussdb-driver",
  "description": "Cube.js GaussDB 507 centralized PG-mode JDBC driver",
  "author": "Cube Dev, Inc.",
  "version": "1.6.61",
  "repository": {
    "type": "git",
    "url": "https://github.com/cube-js/cube.git",
    "directory": "packages/cubejs-gaussdb-driver"
  },
  "engines": {
    "node": ">=17.0.0"
  },
  "files": [
